# このファイルを .env にコピーして値を埋める（.env は .gitignore 済み）。
# シェルへ読み込む例:  set -a && source .env && set +a

# --- OANDA (FX) ---
OANDA_ACCOUNT_ID=101-000-0000000-000
OANDA_API_TOKEN=

# --- 通知 ---
DISCORD_WEBHOOK_URL=

# --- 仮想通貨取引所（ccxt 汎用） ---
CCXT_API_KEY=
CCXT_API_SECRET=
CCXT_API_PASSPHRASE=

# --- BingX ---
# 取引権限のみ。出金権限は絶対に付けないこと
BINGX_API_KEY=
BINGX_API_SECRET=
